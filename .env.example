# Port the server listens on
PORT=3000
# Where the SQLite database and automatic backups are stored (mount a persistent disk here)
DATA_DIR=./data
# Optional: fixed secret for signing sessions (otherwise generated and stored in the database)
# JWT_SECRET=change-me-to-a-long-random-string
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false
# Set to 1 when running behind a reverse proxy (Nginx, Caddy, Render, Railway...)
# TRUST_PROXY=1
# Business timezone used for "today", overdue and expiry calculations
APP_TZ=Asia/Kuala_Lumpur
# Daily automatic database snapshot (true/false)
AUTO_BACKUP=true
# Required on public servers: code needed to create the first administrator account
# SETUP_CODE=choose-a-secret-code
