an", "s": 1061.26, "e": 1061.6, "p": 0.7406617403030396}, {"w": " tak", "s": 1061.6, "e": 1061.72, "p": 0.9075080752372742}, {"w": " ada", "s": 1061.72, "e": 1061.86, "p": 0.8509851098060608}, {"w": " hadir", "s": 1061.86, "e": 1062.2, "p": 0.859542191028595}]}, {"start": 1063.0, "end": 1063.74, "text": " Tentu dia dah", "words": [{"w": " Tentu", "s": 1063.0, "e": 1063.52, "p": 0.3361008216937383}, {"w": " dia", "s": 1063.52, "e": 1063.64, "p": 0.5143385529518127}, {"w": " dah", "s": 1063.64, "e": 1063.74, "p": 0.532561182975769}]}, {"start": 1064.7, "end": 1065.76, "text": " Jadi apa tu", "words": [{"w": " Jadi", "s": 1064.7, "e": 1065.22, "p": 0.7489228844642639}, {"w": " apa", "s": 1065.22, "e": 1065.62, "p": 0.4683731496334076}, {"w": " tu", "s": 1065.62, "e": 1065.76, "p": 0.9952067732810974}]}, {"start": 1065.76, "end": 1067.84, "text": " Dugung kat atas sampel tu", "words": [{"w": " Dugung", "s": 1065.76, "e": 1066.56, "p": 0.6037978927294413}, {"w": " kat", "s": 1066.56, "e": 1066.72, "p": 0.6457018852233887}, {"w": " atas", "s": 1066.72, "e": 1066.98, "p": 0.9987121820449829}, {"w": " sampel", "s": 1066.98, "e": 1067.66, "p": 0.9913434982299805}, {"w": " tu", "s": 1067.66, "e": 1067.84, "p": 0.9979793429374695}]}, {"start": 1083.14, "end": 1085.02, "text": " tak mancing, air mati", "words": [{"w": " tak", "s": 1083.14, "e": 1083.76, "p": 0.19536393880844116}, {"w": " mancing,", "s": 1083.76, "e": 1084.32, "p": 0.9874763190746307}, {"w": " air", "s": 1084.34, "e": 1084.58, "p": 0.9739969372749329}, {"w": " mati", "s": 1084.58, "e": 1085.02, "p": 0.998116135597229}]}, {"start": 1085.02, "end": 1086.22, "text": " musuh hujan petang pula", "words": [{"w": " musuh", "s": 1085.02, "e": 1085.32, "p": 0.5842202007770538}, {"w": " hujan", "s": 1085.32, "e": 1085.62, "p": 0.9720095098018646}, {"w": " petang", "s": 1085.62, "e": 1086.0, "p": 0.9698041677474976}, {"w": " pula", "s": 1086.0, "e": 1086.22, "p": 0.8988918662071228}]}, {"start": 1087.5, "end": 1088.56, "te