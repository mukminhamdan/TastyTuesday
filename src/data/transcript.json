 {"w": " tukar", "s": 780.58, "e": 780.8, "p": 0.9925885796546936}, {"w": " bekas", "s": 780.8, "e": 781.24, "p": 0.9998680055141449}]}, {"start": 783.72, "end": 785.54, "text": " Senang tak payah tukar bekas", "words": [{"w": " Senang", "s": 783.72, "e": 784.48, "p": 0.976438969373703}, {"w": " tak", "s": 784.48, "e": 784.64, "p": 0.9909942746162415}, {"w": " payah", "s": 784.64, "e": 784.86, "p": 0.999382346868515}, {"w": " tukar", "s": 784.86, "e": 785.18, "p": 0.9570029973983765}, {"w": " bekas", "s": 785.18, "e": 785.54, "p": 0.9991471469402313}]}, {"start": 785.54, "end": 788.44, "text": " Dah peraya dalam ni sama pun ada juga", "words": [{"w": " Dah", "s": 785.54, "e": 785.78, "p": 0.2481876015663147}, {"w": " peraya", "s": 786.02, "e": 787.1, "p": 0.5898022949695587}, {"w": " dalam", "s": 787.1, "e": 787.32, "p": 0.7716012597084045}, {"w": " ni", "s": 787.32, "e": 787.44, "p": 0.9984090924263}, {"w": " sama", "s": 787.44, "e": 787.76, "p": 0.10943301767110825}, {"w": " pun", "s": 787.76, "e": 788.04, "p": 0.8798291683197021}, {"w": " ada", "s": 788.04, "e": 788.18, "p": 0.8765690326690674}, {"w": " juga", "s": 788.18, "e": 788.44, "p": 0.8602203130722046}]}, {"start": 798.85, "end": 800.65, "text": " Boleh lah beli satu nas", "words": [{"w": " Boleh", "s": 798.85, "e": 799.53, "p": 0.9980912506580353}, {"w": " lah", "s": 799.53, "e": 799.71, "p": 0.5162438750267029}, {"w": " beli", "s": 799.71, "e": 800.07, "p": 0.9745891392230988}, {"w": " satu", "s": 800.07, "e": 800.33, "p": 0.7802985906600952}, {"w": " nas", "s": 800.33, "e": 800.65, "p": 0.8320686221122742}]}, {"start": 800.65, "end": 802.98, "text": " Untuk orang rumah", "words": [{"w": " Untuk", "s": 800.65, "e": 801.29, "p": 0.9592551290988922}, {"w": " orang", "s": 802.46, "e": 802.62, "p": 0.9990768432617188}, {"w": " rumah", "s": 802.62, "e": 802.98, "p": 0.9938825368881226}]}, {"start": 804.21, "end": 809.42, "text": " Satu buku pun senang", "words": [{"w": " Satu", "s": 804.21, "e": 804.81, "p": 0.4813408628106117}, {"w": " buku", "s": 808.64, "e": 808.86, "p": 0.43856483697891235}, {"w": " pun", "s": 808.86, "e": 809.0, "p": 0.8762430548667908}, {"w": " senang", "s": 809.0, "e": 809.42, "p": 0.9990640580654144}]}, {"start": 813.05, "end": 814.69, "text": " Dia bekas dia 8 liter", "words": [{"w": " Dia", "s": 813.05, "e": 813.63, "p": 0.7284783124923706}, {"w": " bekas", "s": 813.63, "e": 813.99, "p": 0.9882608652114868}, {"w": " dia", "s": 813.99, "e": 814.09, "p": 0.7426115274429321}, {"w": " 8", "s": 814.09, "e": 814.31, "p": 0.9774824976921082}, {"w": " liter", "s": 814.31, "e": 814.69, "p": 0.8293799757957458}]}, {"start": 814.69, "end": 816.31, "text": " Jadi muat lah", "words": [{"w": " Jadi", "s": 814.69, "e": 815.39, "p": 0.9728860855102539}, {"w": " muat", "s": 815.39, "e": 816.11, "p": 0.6984254419803619}, {"w": " lah", "s": 816.11, "e": 816.31, "p": 0.8348537683486938}]}, {"start": 823.4, "end": 826.67, "text": " Besar 8 liter ni", "words": [{"w": " Besar", "s": 823.4, "e": 824.44, "p": 0.767262190580368}, {"w": " 8", "s": 824.44, "e": 824.8, "p": 0.9252051115036011}, {"w": " liter", "s": 826.19, "e": 826.49, "p": 0.9988862872123718}, {"w": " ni", "s": 826.49, "e": 826.67, "p": 0.9983730316162109}]}, {"start": 827.88, "end": 829.36, "text": " Asik pun 2 kilo lebih", "words": [{"w": " Asik", "s": 827.88, "e": 828.48, "p": 0.4379764358163811}, {"w": " pun", "s": 828.48, "e": 828.66, "p": 0.9983376264572144}, {"w": " 2", "s": 828.66, "e": 828.84, "p": 0.9955240488052368}, {"w": " kilo", "s": 828.84, "e": 829.1, "p": 0.6595011353492737}, {"w": " lebih", "s": 829.1, "e": 829.36, "p": 0.9921646118164062}]}, {"start": 829.36, "end": 864.66, "text": " Boleh masuk. Tak buat yang segera", "words": [{"w": " Boleh", "s": 829.36, "e": 829.36, "p": 0.5107681639492512}, {"w": " masuk.", "s": 829.36, "e": 830.16, "p": 0.8772146701812744}, {"w": " Tak", "s": 830.4, "e": 830.6, "p": 0.6876739859580994}, {"w": " buat", "s": 863.96, "e": 864.18, "p": 0.4911690354347229}, {"w": " yang", "s": 864.18, "e": 864.3, "p": 0.46475720405578613}, {"w": " segera", "s": 864.3, "e": 864.66, "p": 0.7683344682057699}]}, {"start": 864.66, "end": 866.12, "text": " Bukan besar. Bukan besar-besar lain lah.", "words": [{"w": " Bukan", "s": 864.66, "e": 864.88, "p": 0.08712065778672695}, {"w": " besar.", "s": 864.88, "e": 865.14, "p": 0.21106232702732086}, {"w": " Bukan", "s": 865.38, "e": 865.52, "p": 0.5224051214754581}, {"w": " besar", "s": 865.52, "e": 865.64, "p": 0.42937150597572327}, {"w": "-besar", "s": 865.64, "e": 865.7, "p": 0.3236311872800191}, {"w": " lain", "s": 865.7, "e": 865.88, "p": 0.7181066274642944}, {"w": " lah.", "s": 865.88, "e": 866.12, "p": 0.7110857963562012}]}, {"start": 866.24, "end": 866.9, "text": " Ini buat ke rumah.", "words": [{"w": " Ini", "s": 866.24, "e": 866.34, "p": 0.18052490055561066}, {"w": " buat", "s": 866.34, "e": 866.48, "p": 0.9849157333374023}, {"w": " ke", "s": 866.48, "e": 866.6, "p": 0.1784752905368805}, {"w": " rumah.", "s": 866.6, "e": 866.9, "p": 0.9400734305381775}]}, {"start": 867.36, "end": 888.02, "text": " Makar-makar kek boleh dah sampai.", "words": [{"w": " Makar", "s": 867.36, "e": 867.84, "p": 0.4719867669045925}, {"w": "-makar", "s": 867.84, "e": 869.76, "p": 0.8240049878756205}, {"w": " kek", "s": 887.18, "e": 887.46, "p": 0.9694684147834778}, {"w": " boleh", "s": 887.46, "e": 887.7, "p": 0.4848611652851105}, {"w": " dah", "s": 887.7, "e": 887.86, "p": 0.4494415819644928}, {"w": " sampai.", "s": 887.86, "e": 888.02, "p": 0.07683504372835159}]}, {"start": 888.18, "end": 889.18, "text": " Tak payah nak boleh oven lah.", "words": [{"w": " Tak", "s": 888.18, "e": 888.24, "p": 0.9509000182151794}, {"w": " payah", "s": 888.24, "e": 888.46, "p": 0.6781351417303085}, {"w": " nak", "s": 888.46, "e": 888.56, "p": 0.8862284421920776}, {"w": " boleh", "s": 888.56, "e": 888.72, "p": 0.2912229299545288}, {"w": " oven", "s": 888.72, "e": 888.98, "p": 0.9845160245895386}, {"w": " lah.", "s": 888.98, "e": 889.18, "p": 0.7468357086181641}]}, {"start": 889.89, "end": 891.97, "text": " Sekali dengan oven sekali. Ayam boleh", "words": [{"w": " Sekali", "s": 889.89, "e": 890.29, "p": 0.4905831553041935}, {"w": " dengan", "s": 890.29, "e": 890.39, "p": 0.8528176546096802}, {"w": " oven", "s": 890.39, "e": 890.69, "p": 0.9990106821060181}, {"w": " sekali.", "s": 890.69, "e": 890.95, "p": 0.9765253067016602}, {"w": " Ayam", "s": 891.33, "e": 891.81, "p": 0.6301466971635818}, {"w": " boleh", "s": 891.81, "e": 891.97, "p": 0.9432051181793213}]}, {"start": 891.97, "end": 893.69, "text": " Ayam buat dua ekor. Ayam percik boleh.", "words": [{"w": " Ayam", "s": 891.97, "e": 892.31, "p": 0.508019077591598}, {"w": " buat", "s": 892.31, "e": 892.47, "p": 0.6592780947685242}, {"w": " dua", "s": 892.47, "e": 892.59, "p": 0.3928694427013397}, {"w": " ekor.", "s": 892.59, "e": 892.81, "p": 0.7174456119537354}, {"w": " Ayam", "s": 892.93, "e": 893.17, "p": 0.7359297573566437}, {"w": " percik", "s": 893.17, "e": 893.51, "p": 0.8835316896438599}, {"w": " boleh.", "s": 893.51, "e": 893.69, "p": 0.9861894249916077}]}, {"start": 893.87, "end": 894.85, "text": " Nani agam percik lah.", "words": [{"w": " Nani", "s": 893.87, "e": 894.19, "p": 0.22068443149328232}, {"w": " agam", "s": 894.19, "e": 894.41, "p": 0.21081312000751495}, {"w": " percik", "s": 894.41, "e": 894.75, "p": 0.9257559180259705}, {"w": " lah.", "s": 894.75, "e": 894.85, "p": 0.8541910648345947}]}, {"start": 937.81, "end": 952.26, "text": " Ok, saya nak kemudian", "words": [{"w": " Ok,", "s": 937.81, "e": 938.11, "p": 0.2603599429130554}, {"w": " saya", "s": 951.12, "e": 951.16, "p": 0.09034942090511322}, {"w": " nak", "s": 951.16, "e": 951.58, "p": 0.43305036425590515}, {"w": " kemudian", "s": 951.58, "e": 952.26, "p": 0.3846867394944032}]}, {"start": 952.76, "end": 953.72, "text": " Okey, okey.", "words": [{"w": " Okey,", "s": 952.76, "e": 953.1, "p": 0.000946472049690783}, {"w": " okey.", "s": 953.58, "e": 953.72, "p": 0.5895857140421867}]}, {"start": 955.12, "end": 955.84, "text": " Assalamualaikum, Nas.", "words": [{"w": " Assalamualaikum,", "s": 955.12, "e": 955.6, "p": 0.8331268966197968}, {"w": " Nas.", "s": 955.7, "e": 955.84, "p": 0.8567440509796143}]}, {"start": 956.14, "end": 957.28, "text": " Pulang balik. Bagikah.", "words": [{"w": " Pulang", "s": 956.14, "e": 956.42, "p": 0.5532124936580658}, {"w": " balik.", "s": 956.42, "e": 956.66, "p": 0.9604986310005188}, {"w": " Bagikah.", "s": 956.82, "e": 957.28, "p": 0.48272547622521716}]}, {"start": 958.97, "end": 959.75, "text": " Bojar-bojar.", "words": [{"w": " Bojar", "s": 958.97, "e": 959.45, "p": 0.0690915398299694}, {"w": "-bojar.", "s": 959.45, "e": 959.75, "p": 0.8240508437156677}]}, {"start": 967.72, "end": 968.2, "text": " Assalamualaikum", "words": [{"w": " Assalamualaikum", "s": 967.72, "e": 968.2, "p": 0.9190964698791504}]}, {"start": 1541.06, "end": 1543.24, "text": " Hello siapa yang ada kat dalam ni", "words": [{"w": " Hello", "s": 1541.06, "e": 1541.7, "p": 0.1807420700788498}, {"w": " siapa", "s": 1541.7, "e": 1542.32, "p": 0.8032174706459045}, {"w": " yang", "s": 1542.32, "e": 1542.52, "p": 0.981238603591919}, {"w": " ada", "s": 1542.52, "e": 1542.7, "p": 0.9215382933616638}, {"w": " kat", "s": 1542.7, "e": 1542.84, "p": 0.8388051986694336}, {"w": " dalam", "s": 1542.84, "e": 1543.06, "p": 0.8827185034751892}, {"w": " ni", "s": 1543.06, "e": 1543.24, "p": 0.9782344698905945}]}, {"start": 1547.32, "end": 1698.92, "text": " Macam mana rasa?", "words": [{"w": " Macam", "s": 1547.32, "e": 1548.22, "p": 0.5407247766852379}, {"w": " mana", "s": 1548.22, "e": 1548.74, "p": 0.3514522314071655}, {"w": " rasa?", "s": 1698.68, "e": 1698.92, "p": 0.9853331446647644}]}, {"start": 1717.53, "end": 1717.95, "text": " Ok dah", "words": [{"w": " Ok", "s": 1717.53, "e": 1717.79, "p": 0.11767340451478958}, {"w": " dah", "s": 1717.79, "e": 1717.95, "p": 0.304280161857605}]}, {"start": 1813.5, "end": 1814.14, "text": " Siap", "words": [{"w": " Siap", "s": 1813.5, "e": 1814.14, "p": 0.9303015470504761}]}, {"start": 1815.46, "end": 1817.8, "text": " Sorry siapa yang tak dapat tengok", "words": [{"w": " Sorry", "s": 1815.46, "e": 1816.18, "p": 0.4560064971446991}, {"w": " siapa", "s": 1816.18, "e": 1816.86, "p": 0.9181459248065948}, {"w": " yang", "s": 1816.86, "e": 1817.0, "p": 0.9966394901275635}, {"w": " tak", "s": 1817.0, "e": 1817.1, "p": 0.970615804195404}, {"w": " dapat", "s": 1817.1, "e": 1817.34, "p": 0.8240001201629639}, {"w": " tengok", "s": 1817.34, "e": 1817.8, "p": 0.8914612829685211}]}, {"start": 1817.8, "end": 1819.02, "text": " Muka tu", "words": [{"w": " Muka", "s": 1817.8, "e": 1818.7, "p": 0.8682856559753418}, {"w": " tu", "s": 1818.7, "e": 1819.02, "p": 0.9609515070915222}]}, {"start": 1819.02, "end": 1819.62, "text": " Ok", "words": [{"w": " Ok", "s": 1819.02, "e": 1819.62, "p": 0.8548634052276611}]}, {"start": 1925.01, "end": 1926.41, "text": " Malam kita malam", "words": [{"w": " Malam", "s": 1925.01, "e": 1925.65, "p": 0.416599593590945}, {"w": " kita", "s": 1925.65, "e": 1925.97, "p": 0.9392517805099487}, {"w": " malam", "s": 1925.97, "e": 1926.41, "p": 0.6549948751926422}]}, {"start": 1926.41, "end": 1938.67, "text": " Jadi saya sambung dah balik", "words": [{"w": " Jadi", "s": 1926.41, "e": 1927.21, "p": 0.232027068734169}, {"w": " saya", "s": 1934.73, "e": 1936.57, "p": 0.982269823551178}, {"w": " sambung", "s": 1937.93, "e": 1938.25, "p": 0.9226747453212738}, {"w": " dah", "s": 1938.25, "e": 1938.37, "p": 0.8009306192398071}, {"w": " balik", "s": 1938.37, "e": 1938.67, "p": 0.9655526578426361}]}, {"start": 1938.67, "end": 1940.94, "text": " Nak solat", "words": [{"w": " Nak", "s": 1938.67, "e": 1939.47, "p": 0.0574573390185833}, {"w": " solat", "s": 1940.38, "e": 1940.94, "p": 0.9485201239585876}]}]