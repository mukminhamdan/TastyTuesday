, "end": 590.55, "text": " tak siri lah, kalau dalam saman", "words": [{"w": " tak", "s": 588.56, "e": 588.98, "p": 0.07703158259391785}, {"w": " siri", "s": 589.03, "e": 589.59, "p": 0.5092283189296722}, {"w": " lah,", "s": 589.59, "e": 589.71, "p": 0.6956726312637329}, {"w": " kalau", "s": 589.73, "e": 589.91, "p": 0.9121228456497192}, {"w": " dalam", "s": 589.91, "e": 590.07, "p": 0.8093322515487671}, {"w": " saman", "s": 590.07, "e": 590.55, "p": 0.714343324303627}]}, {"start": 590.55, "end": 592.87, "text": " kadang-kadang sama-sama tak siri", "words": [{"w": " kadang", "s": 590.55, "e": 591.13, "p": 0.7931039333343506}, {"w": "-kadang", "s": 591.59, "e": 591.77, "p": 0.919480045636495}, {"w": " sama", "s": 591.77, "e": 592.09, "p": 0.40606752038002014}, {"w": "-sama", "s": 592.09, "e": 592.31, "p": 0.5622051656246185}, {"w": " tak", "s": 592.31, "e": 592.39, "p": 0.7813079953193665}, {"w": " siri", "s": 592.39, "e": 592.87, "p": 0.8800386488437653}]}, {"start": 592.87, "end": 597.92, "text": " yang beza ni dan jintan", "words": [{"w": " yang", "s": 592.87, "e": 593.19, "p": 0.22717995941638947}, {"w": " beza", "s": 596.7, "e": 597.1, "p": 0.751092940568924}, {"w": " ni", "s": 597.1, "e": 597.26, "p": 0.9718889594078064}, {"w": " dan", "s": 597.26, "e": 597.44, "p": 0.2724528908729553}, {"w": " jintan", "s": 597.44, "e": 597.92, "p": 0.8982937137285868}]}, {"start": 598.28, "end": 600.74, "text": " tu tak kicap sikit nanti, ni jadi sambal", "words": [{"w": " tu", "s": 598.28, "e": 598.74, "p": 0.11896924674510956}, {"w": " tak", "s": 598.74, "e": 598.86, "p": 0.5441166758537292}, {"w": " kicap", "s": 598.86, "e": 599.16, "p": 0.9698512752850851}, {"w": " sikit", "s": 599.16, "e": 599.36, "p": 0.9713729918003082}, {"w": " nanti,", "s": 599.36, "e": 599.72, "p": 0.7169427275657654}, {"w": " ni", "s": 599.76, "e": 600.12, "p": 0.8239051103591919}, {"w": " jadi", "s": 600.12, "e": 600.24, "p": 0.8952242732048035}, {"w": " sambal", "s": 600.24, "e": 600.74, "p": 0.9