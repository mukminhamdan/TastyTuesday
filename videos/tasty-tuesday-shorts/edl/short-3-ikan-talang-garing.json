    {"in": 4686.35, "out": 4688.45, "cap": "Kalau goreng garing, lagi sedap.", "hot": ["garing"], "sfx": [["whoosh", -0.15, 0.5]]},
    {"in": 4702.0, "out": 4705.05, "cap": "Makan sambal, tapi asinglah sambal itu. Tak gaulkan dengan ikan.", "hot": ["asinglah"]},
    {"in": 4714.05, "out": 4718.15, "cap": "Bila kita goreng garing, kita rasa kulit dia macam crispy.", "hot": ["crispy"]},
