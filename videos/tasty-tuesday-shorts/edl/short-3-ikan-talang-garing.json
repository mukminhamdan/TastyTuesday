    {"in": 3050.8, "out": 3052.85, "cap": "Tak perlu pun minyak banyak-banyak."},
    {"in": 3057.05, "out": 3060.35, "cap": "Kalau minyak sedikit, dia automatik pre-heat sekejap je.", "hot": ["sekejap"]},
    {"in": 3358.65, "out": 3360.6, "cap": "Dah siap ikan goreng!", "hot": ["siap"], "sfx": [["sparkle", 0, 0.6]]},
